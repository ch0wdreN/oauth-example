{
  "$id": "https://schemas.ory.sh/presets/kratos/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Full Name",
          "minLength": 1
        },
        "given_name": {
          "type": "string",
          "title": "Given Name"
        },
        "family_name": {
          "type": "string",
          "title": "Family Name"
        },
        "picture": {
          "type": "string",
          "title": "Profile Picture URL",
          "format": "uri"
        },
        "phone_number": {
          "type": "string",
          "title": "Phone Number"
        },
        "birthdate": {
          "type": "string",
          "format": "date",
          "title": "Birth Date"
        },
        "locale": {
          "type": "string",
          "title": "Locale",
          "default": "ja-JP"
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    }
  }
}
